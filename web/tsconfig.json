{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "typeRoots": ["../cache/web/node_modules/@types"],
    "paths": {
      "@bokuweb/zstd-wasm": [
        "../cache/web/node_modules/@bokuweb/zstd-wasm/dist/web/index.web.d.ts"
      ],
      "html-to-image": ["../cache/web/node_modules/html-to-image/lib/index.d.ts"],
      "react": ["../cache/web/node_modules/@types/react"],
      "react/*": ["../cache/web/node_modules/@types/react/*"],
      "react-dom/*": ["../cache/web/node_modules/@types/react-dom/*"],
      "vite/client": ["../cache/web/node_modules/vite/client.d.ts"]
    }
  },
  "include": ["src", "tests/**/*.ts", "tests/**/*.tsx", "vite.config.ts"]
}
