# Partial unequipped Skill rotation. Five packets per cast use disclosed coincident timing.
# This does not exercise Authority recasts, full chains or Underboss behavior.
options iteration=1 duration=25 crit=fixed;
nanally char lvl=80/80 awakening=0 talent=8,8,8 qte=8 +params=[start_energy=0];
sakiri char lvl=80/80 awakening=0 talent=8,8,8 qte=8;
target hp=10000000 def=1080 resist=0;
active nanally;
nanally skill;
sakiri swap;
wait(20);
nanally skill;
