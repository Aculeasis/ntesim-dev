# Partial unequipped Jiuyuan rotation: two Skill casts (6 hits each) and one Burst (12 hits).
# Timing uses the disclosed coincident-packet model; animation delays and bullet consumption are pending.
options iteration=1 duration=35 crit=fixed;
jiuyuan char lvl=80/80 awakening=0 talent=8,8,8 qte=8 start_energy=100;
mint char lvl=80/80 awakening=0 talent=8,8,8 qte=8;
target hp=10000000 def=1080 resist=0;
active jiuyuan;
jiuyuan skill, burst;
mint swap;
wait(16);
jiuyuan skill;
