# Legal A0 source baseline; two continuing 150s periods, no combat resets.
# Blue group-compatible Arc and declared two-piece static ATK bonus.
options duration=300 seed=42 start_fons=0
 stamina_capacity=200 initial_stamina=200 stamina_use_efficiency=1 stamina_recovery_rate=10;
hotori char lvl=80/80 awakening=0 talent=8,8,8 qte=8 start_energy=0;
hotori add weapon=fork_nonos refine=1;
hotori add cartridge=Suit8 count=2;
hotori add stats atk%=0.5 atk=300 cr=0.3 cd=0.5;
target hp=100000000 def=1080 resist=0.2;
target hp=100000000 def=1080 resist=0.2;
active hotori;

repeat 2 {
    let period=.time;
    repeat 12 {hotori attack:5;}
    hotori skill; wait(20); hotori burst;
    while .hotori.time_stop.active {hotori attack[window=attack];}
    hotori attack:5;
    wait_until(period+150);
}
