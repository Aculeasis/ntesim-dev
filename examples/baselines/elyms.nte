# Legal A0 source baseline; two continuing 150s periods, no combat resets.
# Uses Echoes on Hold, Akane companion entry for QTE and Remora Enhancement, and two-piece static ATK bonus.
options duration=300 seed=42 start_fons=0
 stamina_capacity=200 initial_stamina=200 stamina_use_efficiency=1 stamina_recovery_rate=10;
elyms char lvl=80/80 awakening=0 talent=8,8,8 qte=8 start_energy=0;
elyms add weapon=fork_elyms refine=1;
elyms add cartridge=Suit8 count=2;
elyms add stats atk%=0.5 atk=300 cr=0.3 cd=0.5;
akane char lvl=80/80 awakening=0 talent=8,8,8 qte=8 start_energy=0;
akane add weapon=fork_prism refine=1;
target hp=100000000 def=1080 resist=0.2;
target hp=100000000 def=1080 resist=0.2;
active elyms;

repeat 2 {
    let period = .time;
    if .elyms.skill.ready { elyms skill; }
    elyms attack:3;
    if .elyms.skill.ready && .elyms.power_e2.active { elyms skill; }
    while !.elyms.burst.ready {
        if .elyms.skill.ready { elyms skill; } else { elyms attack; }
    }
    elyms burst;
    akane swap;
    if .akane.skill.ready { akane skill; }
    wait(18);
    elyms swap;
    wait_until(period + 150);
}
