# Legal A0 source baseline; two continuing 150s periods, no combat resets.
# Blue group-compatible Arc and declared two-piece static ATK bonus.
options duration=300 seed=42 start_fons=0
 stamina_capacity=200 initial_stamina=200 stamina_use_efficiency=1 stamina_recovery_rate=10;
blackbird char lvl=80/80 awakening=0 talent=8,8,8 qte=8 start_energy=0;
blackbird add weapon=fork_vine refine=1;
blackbird add cartridge=Suit8 count=2;
blackbird add stats atk%=0.5 atk=300 cr=0.3 cd=0.5 ce=1.1;
target hp=100000000 def=1080 resist=0.2;
target hp=100000000 def=1080 resist=0.2;
active blackbird;

repeat 2 {
    let period=.time;
    repeat 12 {blackbird attack:5;}
    blackbird skill, burst;
    blackbird plunge[airtime=600ms,height_bonus=1/2];
    blackbird attack:5, skill, attack:5, burst;
    wait_until(period+150);
}
