# Legal A0 source baseline; two continuing 150s periods, no combat resets.
# Uses Far Side of the Moon, Zero companion entry for Remora/Perfect Pitch, and Sonic Boom Stage 2.
options duration=300 seed=42 start_fons=0
 stamina_capacity=200 initial_stamina=200 stamina_use_efficiency=1 stamina_recovery_rate=10;
akane char lvl=80/80 awakening=0 talent=8,8,8 qte=8 start_energy=0;
akane add weapon=fork_prism refine=1;
akane add cartridge=Suit8 count=2;
akane add stats atk%=0.5 atk=300 cr=0.3 cd=0.5;
zero char lvl=80/80 awakening=0 talent=8,8,8 qte=8 start_energy=0;
zero add weapon=fork_nonos refine=1;
target hp=100000000 def=1080 resist=0.2;
target hp=100000000 def=1080 resist=0.2;
active akane;

repeat 2 {
    let period = .time;
    akane skill;
    akane attack:4;
    akane attack:4;
    zero swap;
    wait(1);
    akane swap;
    repeat 3 {
        akane attack:4;
    }
    if .akane.burst.ready {
        akane burst;
        wait(4);
        akane burst;
    }
    wait_until(period + 150);
}
