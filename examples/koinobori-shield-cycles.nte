options iteration=1 duration=40 crit=fixed;

adler char lvl=80/80 awakening=0 talent=1,1,1 qte=1;
adler add weapon=fork_koinobori refine=1;
zero char lvl=80/80 awakening=0 talent=1,1,1 qte=1;
mint char lvl=80/80 awakening=0 talent=1,1,1 qte=1;
target hp=100000000 def=0 resist=0;
active adler;

# Three distinct party elements qualify the wearer's ATK/DEF/HP bonuses.
adler skill; adler attack:3; mint swap;
wait_until(20); adler swap; adler skill; adler attack:3; mint swap;
