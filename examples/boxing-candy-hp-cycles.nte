options iteration=1 duration=30 crit=fixed;
nanally char lvl=80/80 awakening=0 talent=1,1,1 qte=1;
nanally add weapon=fork_BoxingCandy refine=1;
nanally add stats dmg%=0.25;
mint char lvl=80/80 awakening=0 talent=1,1,1 qte=1;
zero char lvl=80/80 awakening=0 talent=1,1,1 qte=1 start_cycle=100;
target hp=1000000 def=0 resist=0;
target hp=1000000 def=0 resist=0;
active nanally;

repeat 5 { nanally attack; wait(0.7); } mint swap; mint attack:5;
wait_until(15); zero swap; nanally swap; wait(1.31); repeat 5 { nanally attack; wait(0.7); }
