options duration=40 seed=42;
blackbird char lvl=80/80 awakening=0 talent=8,8,8 qte=8 start_energy=0;
blackbird add weapon=fork_twinbirds refine=1;
lacrimosa char lvl=80/80 awakening=0 talent=8,8,8 qte=8 start_energy=0;
lacrimosa add weapon=fork_BlackBook refine=1;
target hp=100000000 def=1080 resist=0;
target hp=100000000 def=1080 resist=0;
active blackbird;

# Ordinary resource/controller acceptance retains the caller's action clocks.
# Form replacement and the owner's causal montage clock are separate models.
repeat 2 {
    blackbird skill;
    wait(0.3);
    lacrimosa swap;
    repeat 11 { lacrimosa attack; wait(0.2); }
    blackbird swap;
    wait(4);
}
