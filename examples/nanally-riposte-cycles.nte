options iteration=1 duration=8 crit=fixed stamina_capacity=60 initial_stamina=60 stamina_use_efficiency=1 stamina_recovery_rate=0;
nanally char lvl=80/80 awakening=0 talent=1,1,1 qte=1 start_energy=0;
mint char lvl=80/80 awakening=0 talent=1,1,1 qte=1 start_energy=0;
nanally add stats dmg%=0.25;
target hp=100000000 def=0 resist=0;
target hp=100000000 def=0 resist=0;
active nanally;

# Two paid opportunities survive explicit waits and are consumed once each.
# The next ordinary input restarts the Normal chain after full recovery.
nanally dash[critical=true]; wait(1); nanally attack;
wait(0.34); nanally attack;
wait_until(4); nanally dash[critical=true]; nanally attack;
wait(0.34); nanally attack;
