options iteration=1 duration=90 crit=fixed seed=42;
mint char lvl=80/80 awakening=0 talent=1,1,1 qte=1 start_energy=100;
mint add weapon=fork_appliance refine=1;
mint add stats dmg%=0.25;
sakiri char lvl=80/80 awakening=0 talent=1,1,1 qte=1;
target hp=100000000 def=0 resist=0;
target hp=100000000 def=0 resist=0;
active mint;

# Only Redirect packets qualify; the funded second Burst keeps category Q.
mint skill; mint burst;
mint attack:40;
sakiri swap; wait(1); sakiri skill;
wait_until(60); mint swap; mint skill; mint burst;
sakiri swap; wait(1); sakiri attack;
