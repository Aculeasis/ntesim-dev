# Fadia A0 continuing rotation: build from empty energy, pay Burst, and continue.
# Normal hit energy and packet timing use the named owner hypotheses.
options iteration=1 duration=80s crit=fixed;
fadia char lvl=80/80 awakening=0 talent=8,8,8 qte=8 start_energy=0;
mint char lvl=80/80 awakening=0 talent=8,8,8 qte=8 start_energy=0;
hathor char lvl=80/80 awakening=0 talent=8,8,8 qte=8 start_energy=0;
target hp=100000000 def=1080 resist=0;
active fadia;

repeat 6 { fadia attack:5; }
fadia burst;
wait(.fadia.mods.lilith);
fadia attack:5;
