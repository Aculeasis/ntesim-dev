options iteration=1 duration=40 crit=fixed;

lacrimosa char lvl=80/80 awakening=0 talent=1,1,1 qte=1 start_energy=0;
lacrimosa add weapon=fork_Rose refine=1;
mint char lvl=80/80 awakening=0 talent=1,1,1 qte=1 start_energy=0;
target hp=100000000 def=0 resist=0 break_gauge=1/10 max_break_gauge=1/10 broken_duration=2;
target hp=100000000 def=0 resist=0 break_gauge=1/10 max_break_gauge=1/10 broken_duration=2;
active lacrimosa;

# Real Skill applications generate Nightmare and extend each Broken dummy once.
lacrimosa skill; mint swap;
wait_until(20); lacrimosa swap; lacrimosa skill; mint swap;
