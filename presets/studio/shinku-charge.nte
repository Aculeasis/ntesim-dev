# Shinku · Charge
# Curated comparison profile: see teams.md for exact stat-line values and assumptions.
options iteration=1000 duration=120 seed=42 start_fons=250000;
# shinku: 15 useful lines; recipe=crit; main=cd:.6.
# C: cr,cd,dmg; III x4: cr,cd; IV: cr,cd; II: cr / cd.
shinku char lvl=80/80 awakening=[] talent=8,8,8 qte=8;
shinku add weapon=fork_lunarphase refine=1 lvl=80/80;
shinku add cartridge=lostradiance count=4;
shinku add stats hp=5600 atk=420 cr=0.28 cd=1.80 dmg%=0.1;
# iroi: 15 useful lines; recipe=support; main=atk%:.375.
# C: atk,cr,dmg; III x4: atk,cr; IV: atk,cr; II: atk / cr.
iroi char lvl=80/80 awakening=[] talent=8,8,8 qte=8;
iroi add weapon=fork_door refine=1 lvl=80/80;
iroi add cartridge=shadowcreed count=4;
iroi add stats hp=5600 atk=420 atk%=1.1250 cr=0.28 dmg%=0.1;
# hathor: 15 useful lines; recipe=crit; main=cd:.6.
# C: cr,cd,dmg; III x4: cr,cd; IV: cr,cd; II: cr / cd.
hathor char lvl=80/80 awakening=[1] talent=8,8,8 qte=8;
hathor add weapon=fork_wushoutieyu refine=1 lvl=80/80;
hathor add cartridge=streetboxer count=4;
hathor add stats hp=5600 atk=420 cr=0.28 cd=1.16 dmg%=0.1 atk%=0.4;
# zero: 15 useful lines; recipe=ci; main=ci:180.
# C: ci,cr,dmg; III x4: ci,atk; IV: ci,atk; II: ci / atk.
zero char lvl=80/80 awakening=6 talent=8,8,8 qte=8;
zero add weapon=fork_rishi refine=1 lvl=80/80;
zero add cartridge=speedyhedgehog count=4;
zero add stats hp=5600 atk=420 ci=348 cr=0.1 dmg%=0.1 atk%=0.6250;
# Common stationary, control-susceptible Boss dummy; no incoming attacks or assumed parries.
target lvl=80 hp=1000000000 max_hp=1000000000 def=1080 resist=0.2 boss=true control_immune=false original_atk=1000 break_gauge=30 max_break_gauge=30 broken_duration=10 discord_fraction=0.1;
active shinku;
# Refresh short support windows, then preserve a sustained damage window.
while 1 {
  zero swap;
  if .zero.burst.ready { zero burst; }
  if .zero.skill.ready { zero skill; }
  hathor swap;
  if .hathor.skill.ready { hathor skill[hold=1.5s]; }
  if .hathor.burst.ready { hathor burst; }
  # Spend Zero's renewed Cycle in the other branch while Remora is active.
  zero swap;
  if .zero.skill.ready { zero skill; }
  iroi swap;
  if .iroi.skill.ready { iroi skill; }
  if .iroi.burst.ready { iroi burst; }

  shinku swap;
  while !.shinku.burst.ready {
    if .shinku.skill.ready { shinku skill; }
    shinku attack;
  }
  shinku burst;
  while .shinku.surging_crimson.active {
    if .shinku.burst.ready && (.shinku.resources.crimson_judgment == 3 || .shinku.mods.surging_crimson <= 2.0) {
      shinku burst;
    } else if .shinku.skill.ready {
      shinku skill;
    } else {
      shinku attack;
    }
  }
}
