# Shinku · Charge / Akane / Elyms
# Curated comparison profile: see teams.md for exact stat-line values and assumptions.
options iteration=1000 duration=120 seed=42 start_fons=250000;
# shinku: 15 useful lines; recipe=crit; main=cd:.6.
# C: cr,cd,dmg; III x4: cr,cd; IV: cr,cd; II: cr / cd.
shinku char lvl=80/80 awakening=[] talent=8,8,8 qte=8;
shinku add weapon=fork_lunarphase refine=1 lvl=80/80;
shinku add cartridge=lostradiance count=4;
shinku add stats hp=5600 atk=420 cr=0.28 cd=1.80 dmg%=0.1;
# akane: 15 useful lines; recipe=crit; main=cd:.6.
# C: cr,cd,dmg; III x4: cr,cd; IV: cr,cd; II: cr / cd.
akane char lvl=80/80 awakening=[] talent=8,8,8 qte=8;
akane add weapon=fork_prism refine=1 lvl=80/80;
akane add cartridge=streetboxer count=4;
akane add stats hp=5600 atk=420 cr=0.28 cd=1.16 dmg%=0.1 atk%=0.4;
# elyms: 15 useful lines; recipe=crit; main=cd:.6.
# C: cr,cd,dmg; III x4: cr,cd; IV: cr,cd; II: cr / cd.
elyms char lvl=80/80 awakening=[] talent=8,8,8 qte=8;
elyms add weapon=fork_elyms refine=1 lvl=80/80;
elyms add cartridge=lostradiance count=4;
elyms add stats hp=5600 atk=420 cr=0.28 cd=1.16 dmg%=0.1 atk%=0.4;
# iroi: 15 useful lines; recipe=support; main=atk%:.375.
# C: atk,cr,dmg; III x4: atk,cr; IV: atk,cr; II: atk / cr.
iroi char lvl=80/80 awakening=[] talent=8,8,8 qte=8;
iroi add weapon=fork_door refine=1 lvl=80/80;
iroi add cartridge=speedyhedgehog count=4;
iroi add stats hp=5600 atk=420 atk%=1.1250 cr=0.28 dmg%=0.1;
# Common stationary, control-susceptible Boss dummy; no incoming attacks or assumed parries.
target lvl=80 hp=1000000000 max_hp=1000000000 def=1080 resist=0.2 boss=true control_immune=false original_atk=1000 break_gauge=30 max_break_gauge=30 broken_duration=10 discord_fraction=0.1;
active elyms;
# Opener uses Elyms Skill2 -> Skill1 (+100 Cycle) into Akane swap to trigger Remora (unlocking Perfect Pitch + Elyms Remora Enhancement for combat), then cycles Akane -> Elyms (Skill1 -> Iroi Blossom/Charge) -> Shinku.
if .elyms.skill.ready && .elyms.power_e1.active { elyms skill; }
if .elyms.skill.ready && .elyms.connection == 1 { elyms skill; }
elyms attack:3;
if .elyms.burst.ready { elyms burst; }
while 1 {
  akane swap;
  if .akane.skill.ready { akane skill; }
  if .akane.burst.ready { akane burst; }

  elyms swap;
  if .elyms.skill.ready && .elyms.power_e1.active { elyms skill; }
  if .elyms.skill.ready { elyms skill; }
  if .elyms.connection >= 1 {
    elyms attack:3;
  } else {
    elyms attack:5;
  }
  if .elyms.power_e2.active && .elyms.skill.ready { elyms skill; }
  if .elyms.burst.ready { elyms burst; }
  if .elyms.resources.cycle < 100 && .elyms.skill.ready { elyms skill; }

  iroi swap;
  if .iroi.burst.ready { iroi burst; }
  if .iroi.skill.ready { iroi skill; }

  shinku swap;
  if !.shinku.burst.ready {
    if .shinku.skill.ready { shinku skill; }
    shinku attack:5;
  }
  if .shinku.burst.ready {
    shinku burst;
    while .shinku.surging_crimson.active {
      if .shinku.burst.ready {
        shinku burst;
      } else if .shinku.skill.ready {
        shinku skill;
      } else {
        shinku attack;
      }
    }
  }
}
