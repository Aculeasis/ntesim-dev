# Skia · Charge
# Curated comparison profile: see teams.md for exact stat-line values and assumptions.
options iteration=1000 duration=120 seed=42 start_fons=250000;
# skia: 15 useful lines; recipe=crit; main=cd:.6.
# C: cr,cd,dmg; III x4: cr,cd; IV: cr,cd; II: cr / cd.
skia char lvl=80/80 awakening=[1,2,3,4,5,6] talent=8,8,8 qte=8;
skia add weapon=fork_kite refine=1 lvl=80/80;
skia add cartridge=streetboxer count=4;
skia add stats hp=5600 atk=420 cr=0.28 cd=1.16 dmg%=0.1 atk%=0.4;
# jiuyuan: 15 useful lines; recipe=crit; main=cd:.6.
# C: cr,cd,dmg; III x4: cr,cd; IV: cr,cd; II: cr / cd.
jiuyuan char lvl=80/80 awakening=[1] talent=8,8,8 qte=8;
jiuyuan add weapon=fork_butterfly refine=1 lvl=80/80;
jiuyuan add cartridge=firefliesandtheforest count=4;
jiuyuan add stats hp=5600 atk=420 cr=0.40 cd=1.16 dmg%=0.1;
# zero: 15 useful lines; recipe=ci; main=ci:180.
# C: ci,cr,dmg; III x4: ci,atk; IV: ci,atk; II: ci / atk.
zero char lvl=80/80 awakening=6 talent=8,8,8 qte=8;
zero add weapon=fork_rishi refine=1 lvl=80/80;
zero add cartridge=speedyhedgehog count=4;
zero add stats hp=5600 atk=420 ci=348 cr=0.1 dmg%=0.1 atk%=0.6250;
# haniel: 15 useful lines; recipe=support; main=atk%:.375.
# C: atk,cr,dmg; III x4: atk,cr; IV: atk,cr; II: atk / cr.
haniel char lvl=80/80 awakening=[1,2,3,4,5,6] talent=8,8,8 qte=8;
haniel add weapon=fork_bitgame refine=1 lvl=80/80;
haniel add cartridge=shadowcreed count=4;
haniel add stats hp=5600 atk=420 atk%=1.1250 cr=0.28 dmg%=0.1;
# Common stationary, control-susceptible Boss dummy; no incoming attacks or assumed parries.
target lvl=80 hp=1000000000 max_hp=1000000000 def=1080 resist=0.2 boss=true control_immune=false original_atk=1000 break_gauge=30 max_break_gauge=30 broken_duration=10 discord_fraction=0.1;
active skia;
# Refresh short support windows, then preserve a sustained damage window.
let next_support = 0;
let last_burst = -20;
while 1 {
  if .time >= next_support {
    haniel swap;
    if .haniel.burst.ready { haniel burst; }
    if .haniel.skill.ready { haniel skill; }
    zero swap;
    if .zero.burst.ready { zero burst; }
    if .zero.skill.ready { zero skill; }
    jiuyuan swap;
    if .jiuyuan.burst.ready { jiuyuan burst; }
    if .jiuyuan.skill.ready { jiuyuan skill; }
    # Spend Zero's renewed Cycle in the other branch while Buds are still alive.
    zero swap;
    while .zero.skill.cd>0 {wait(.zero.skill.cd);}
    zero skill;
    skia swap;
    if .skia.burst.ready { skia burst; }
    if .skia.skill.ready { skia skill; }
    skia swap;
    next_support = .time + 12;
  }
  if .skia.burst.ready { skia burst; }
  if .skia.skill.ready { skia skill; }
  skia attack;
}
