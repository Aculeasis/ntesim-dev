# Blackbird · Stain / Chaos
# Curated comparison profile: see teams.md for exact stat-line values and assumptions.
options iteration=1000 duration=120 seed=42 start_fons=250000;
# blackbird: 15 useful lines; recipe=crit; main=cd:.6.
# C: cr,cd,dmg; III x4: cr,cd; IV: cr,cd; II: cr / cd.
blackbird char lvl=80/80 awakening=[] talent=8,8,8 qte=8;
blackbird add weapon=fork_twinbirds refine=1 lvl=80/80;
blackbird add cartridge=devilsbloodcurse count=4;
blackbird add stats hp=5600 atk=420 cr=0.60 cd=1.16 dmg%=0.1;
# iroi: 15 useful lines; recipe=support; main=atk%:.375.
# C: atk,cr,dmg; III x4: atk,cr; IV: atk,cr; II: atk / cr.
iroi char lvl=80/80 awakening=[] talent=8,8,8 qte=8;
iroi add weapon=fork_door refine=1 lvl=80/80;
iroi add cartridge=speedyhedgehog count=4;
iroi add stats hp=5600 atk=420 atk%=1.1250 cr=0.28 dmg%=0.1;
# daffodil: 15 useful lines; recipe=crit; main=cd:.6.
# C: cr,cd,dmg; III x4: cr,cd; IV: cr,cd; II: cr / cd.
daffodil char lvl=80/80 awakening=[1] talent=8,8,8 qte=8;
daffodil add weapon=fork_blackbook refine=1 lvl=80/80;
daffodil add cartridge=diabolos count=4;
daffodil add stats hp=5600 atk=420 cr=0.28 cd=1.16 dmg%=0.1 chaos%=0.4;
# chaos: 15 useful lines; recipe=crit; main=cd:.6.
# C: cr,cd,dmg; III x4: cr,cd; IV: cr,cd; II: cr / cd.
chaos char lvl=80/80 awakening=[] talent=8,8,8 qte=8;
chaos add weapon=fork_goldwool refine=1 lvl=80/80;
chaos add cartridge=streetboxer count=4;
chaos add stats hp=5600 atk=420 cr=0.28 cd=1.80 dmg%=0.1;
# Common stationary, control-susceptible Boss dummy; no incoming attacks or assumed parries.
target lvl=80 hp=1000000000 max_hp=1000000000 def=1080 resist=0.2 boss=true control_immune=false original_atk=1000 break_gauge=30 max_break_gauge=30 broken_duration=10 discord_fraction=0.1;
active blackbird;
blackbird skill;
# Refresh short support windows, then preserve a sustained damage window.
let next_support = 0;
let last_burst = -20;
while 1 {
  if .time >= next_support && !.blackbird.transformed.active {
    chaos swap;
    if .chaos.burst.ready { chaos burst; }
    if .chaos.skill.ready { chaos skill; }
    daffodil swap;
    if .daffodil.burst.ready { daffodil burst; }
    if .daffodil.skill.ready { daffodil skill; }
    iroi swap;
    if .iroi.skill.ready { iroi skill; }
    if .iroi.burst.ready { iroi burst; }
    blackbird swap;
    next_support = .time + 12;
  }
  if !.blackbird.transformed.active && .blackbird.skill.ready { blackbird skill; }
  if .blackbird.burst.ready && (!.blackbird.transformed.active || .time - last_burst > 8) {
    blackbird burst;
    last_burst = .time;
  }
  if .blackbird.skill.ready { blackbird skill; }
  blackbird attack;
}
