# Baicang · Scorch / Linko
# Curated comparison profile: see teams.md for exact stat-line values and assumptions.
options iteration=1000 duration=120 seed=42 start_fons=250000;
# baicang: 15 useful lines; recipe=crit; main=cd:.6.
# C: cr,cd,dmg; III x4: cr,cd; IV: cr,cd; II: cr / cd.
baicang char lvl=80/80 awakening=[1] talent=8,8,8 qte=8;
baicang add weapon=fork_jingmotingyuan refine=1 lvl=80/80;
baicang add cartridge=crimsontwinbutterflies count=4;
baicang add stats hp=5600 atk=420 cr=0.580 cd=1.16 dmg%=0.1;
# sakiri: 15 useful lines; recipe=support; main=atk%:.375.
# C: atk,cr,dmg; III x4: atk,cr; IV: atk,cr; II: atk / cr.
sakiri char lvl=80/80 awakening=[6] talent=8,8,8 qte=8;
sakiri add weapon=fork_mofeikesi refine=1 lvl=80/80;
sakiri add cartridge=speedyhedgehog count=4;
sakiri add stats hp=5600 atk=420 atk%=0.7250 cr=0.28 dmg%=0.1 incantation%=0.36;
# linko: 15 useful lines; recipe=crit; main=cd:.6.
# C: cr,cd,dmg; III x4: cr,cd; IV: cr,cd; II: cr / cd.
linko char lvl=80/80 awakening=[] talent=8,8,8 qte=8;
linko add weapon=fork_moon refine=1 lvl=80/80;
linko add cartridge=firefliesandtheforest count=4;
linko add stats hp=5600 atk=420 cr=0.60 cd=1.16 dmg%=0.1;
# daffodil: 15 useful lines; recipe=crit; main=cd:.6.
# C: cr,cd,dmg; III x4: cr,cd; IV: cr,cd; II: cr / cd.
daffodil char lvl=80/80 awakening=[1] talent=8,8,8 qte=8;
daffodil add weapon=fork_blackbook refine=1 lvl=80/80;
daffodil add cartridge=diabolos count=4;
daffodil add stats hp=5600 atk=420 cr=0.28 cd=1.16 dmg%=0.1 chaos%=0.4;
# Common stationary, control-susceptible Boss dummy; no incoming attacks or assumed parries.
target lvl=80 hp=1000000000 max_hp=1000000000 def=1080 resist=0.2 boss=true control_immune=false original_atk=1000 break_gauge=30 max_break_gauge=30 broken_duration=10 discord_fraction=0.1;
active baicang;
# Refresh short support windows, then preserve a sustained damage window.
let next_support = 0;
let last_burst = -20;
while 1 {
  if .time >= next_support {
    daffodil swap;
    if .daffodil.burst.ready { daffodil burst; }
    if .daffodil.skill.ready { daffodil skill; }
    sakiri swap;
    if .sakiri.burst.ready { sakiri burst; }
    if .sakiri.skill.ready { sakiri skill; }
    linko swap;
    if .linko.skill.ready { linko skill; }
    if .linko.burst.ready { linko burst; }
    baicang swap;
    next_support = .time + 12;
  }
  if .baicang.burst.ready { baicang burst; }
  if .baicang.skill.ready { baicang skill; }
  baicang attack;
}
